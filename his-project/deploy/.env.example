# 复制为 .env 后修改（.env 不入库）。生产环境必须替换全部默认值。

# 数据库
DB_NAME=his
DB_PORT=3306
DB_PASSWORD=please-change-me

# JWT 签名密钥（长度必须 >= 32 字符）
JWT_SECRET=please-generate-a-random-string-at-least-32-chars

# 身份证 AES-256-GCM 密钥（32 字节的 Base64 串，可用 openssl rand -base64 32 生成）
AES_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# 接口文档开关：生产必须设为 false（swagger/api-docs 匿名暴露高危）
SWAGGER_ENABLED=true

# Flyway：生产环境改为 classpath:db/migration（不加载演示数据）
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
